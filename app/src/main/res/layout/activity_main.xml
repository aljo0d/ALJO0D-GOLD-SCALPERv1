<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content">
                <TextView android:text="ALJO0D" android:textColor="@color/gold" android:textSize="30sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="GOLD SCALPER" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView android:id="@+id/connection" android:text="● OFFLINE" android:textColor="@color/red" android:textSize="12sp" android:textStyle="bold" android:background="@color/card" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:text="TRADING CONFIGURATION" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Expert Advisor" android:textColor="@color/muted" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="ALJO0D Gold Scalper" android:textColor="@color/text" android:textSize="17sp" android:background="@color/card" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="Platform" android:textColor="@color/muted" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/platform" android:layout_width="match_parent" android:layout_height="52dp"/>
        <TextView android:text="Symbol" android:textColor="@color/muted" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="XAUUSD  •  GOLD" android:textColor="@color/text" android:textSize="17sp" android:background="@color/card" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="Lot Size" android:textColor="@color/muted" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/lotMode" android:layout_width="match_parent" android:layout_height="52dp"/>
        <EditText android:id="@+id/customLot" android:hint="Custom lot • 0.01" android:inputType="numberDecimal" android:textColor="@color/text" android:hintTextColor="@color/muted" android:background="@color/card" android:padding="14dp" android:layout_width="match_parent" android:layout_height="52dp"/>

        <TextView android:text="Max Trades" android:textColor="@color/muted" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/maxTrades" android:layout_width="match_parent" android:layout_height="52dp"/>

        <LinearLayout android:orientation="horizontal" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <EditText android:id="@+id/sl" android:hint="SL • points" android:inputType="numberDecimal" android:textColor="@color/text" android:hintTextColor="@color/muted" android:background="@color/card" android:padding="14dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <EditText android:id="@+id/tp" android:hint="TP • points" android:inputType="numberDecimal" android:textColor="@color/text" android:hintTextColor="@color/muted" android:background="@color/card" android:padding="14dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/>
        </LinearLayout>

        <TextView android:text="RISK PROTECTION" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Max Spread\nProtected" android:textColor="@color/text" android:textSize="15sp" android:background="@color/card" android:padding="14dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="72dp"/>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <TextView android:text="Daily Loss\nProtected" android:textColor="@color/text" android:textSize="15sp" android:background="@color/card" android:padding="14dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="72dp"/>
        </LinearLayout>

        <Button android:id="@+id/start" android:text="START  ▶" android:textStyle="bold" android:textSize="17sp" android:backgroundTint="@color/gold" android:textColor="#000000" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="58dp"/>
        <TextView android:id="@+id/status" android:text="●  STOPPED" android:textColor="@color/red" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:padding="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="LIVE ACCOUNT" android:textColor="@color/muted" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/floating" android:text="Floating Profit\n$0.00" android:textColor="@color/text" android:textSize="16sp" android:background="@color/card" android:padding="16dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="88dp"/>
            <Space android:layout_width="10dp" android:layout_height="1dp"/>
            <TextView android:id="@+id/openTrades" android:text="Open Trades\n0" android:textColor="@color/text" android:textSize="16sp" android:background="@color/card" android:padding="16dp" android:layout_weight="1" android:layout_width="0dp" android:layout_height="88dp"/>
        </LinearLayout>
        <TextView android:id="@+id/details" android:text="Last Trade     —\nDirection      —\nSL / TP         —\nSpread          —\nToday P/L       $0.00\nConnection      READY" android:textColor="@color/text" android:textSize="15sp" android:background="@color/card" android:padding="18dp" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button android:id="@+id/stop" android:text="STOP TRADING" android:textStyle="bold" android:backgroundTint="@color/red" android:textColor="#FFFFFF" android:layout_marginTop="14dp" android:layout_width="match_parent" android:layout_height="54dp"/>
        <TextView android:text="No Martingale  •  No loss multiplier  •  Spread & Daily Loss Protection\nBacktest + Demo/Forward Test required before live funds." android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="14dp" android:layout_marginBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
